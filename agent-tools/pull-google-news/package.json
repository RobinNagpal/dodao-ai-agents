{
    "name": "pull-news-from-google",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "compile": "tsc",
        "lint": "next lint",
        "lint-fix": "eslint .. --ext .ts,.js,.tsx --fix",
        "prettier-fix": "prettier --config .prettierrc 'src/**/*.{js,ts,tsx,json}' --write",
        "prettier-check": "prettier --check 'src/**/*.{js,ts,tsx,json}'",
        "postinstall": "prisma generate",
        "start": "ts-node src/server.ts",
        "dev": "nodemon --exec ts-node src/server.ts",
        "build": "tsc"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "@postlight/parser": "^2.2.3",
        "@prisma/client": "^4.13.0",
        "cheerio": "^1.1.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "google-news-scraper": "^2.7.0",
        "helmet": "^7.1.0",
        "jsdom": "^26.1.0",
        "mime-types": "^2.1.35",
        "morgan": "^1.10.0",
        "prisma": "^4.13.0",
        "puppeteer-core": "^24.16.2",
        "typescript": "5.0.4",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@prisma/client": "^4.13.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "18.16.3",
        "@types/unzipper": "^0.10.10",
        "@types/yauzl": "^2.10.3",
        "eslint": "8.39.0",
        "eslint-config-next": "13.3.4",
        "nodemon": "^3.0.3",
        "postcss": "8.4.35",
        "prettier": "^2.8.8",
        "ts-node": "^10.9.2",
        "typescript": "5.0.4"
    }
}
